# Build and coverage outputs
/build/
/dist/
/coverage/
/tmp/
__pycache__/
*.py[cod]
*.test
*.out

# Local credentials and keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
/data/runtime/
/data/backup/

# Raw or potentially real patient data must never enter Git
/data/raw/
/testdata/real/
/fixtures/real/
/phi/private/

# Scratch generators must not enter the PHI or SLOC gates
.tmp_*

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# P0 evidence transient outputs
locaudit_out.txt
phi_result.txt
*-formatted.json

# Transient scanner and gate artifacts must never enter Git.
# They are regenerated by tools/locaudit and tools/phi-scan; the reviewed
# evidence lives under docs/evidence/ and is committed explicitly.
/locaudit*.json
/phi-scan*.json
/phi_*.json
/phi_result*.json
/batch_*.txt
/_*.txt
/_*.py
/_scratch/
*.jsonl.tmp

# Local runner output
/coverage.out
/*.coverprofile
